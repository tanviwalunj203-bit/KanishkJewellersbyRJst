<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - Kanishk Jewellers</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header class="topbar">
  <div class="container nav">
    <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Kanishk Jewellers home">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 100 80"><path d="M8 16h28L50 5l14 11h28L50 73 8 16Z"/><path d="M8 16h84M36 16l14 57M64 16 50 73M23 16l27 57M77 16 50 73"/></svg>
      </span>
      <span class="brand-text">KANISHK<small>JEWELLERS</small></span>
    </a>
    <nav class="main-nav">
      <a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString()=="Home" ? "active" : "")">
        <span class="nav-icon">⌂</span> Home
      </a>
      <a asp-controller="Jewellery" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString()=="Jewellery" ? "active" : "")">
        <span class="nav-icon">◇</span> Jewellery
      </a>
      @if(Context.Session.GetString("IsAdmin")=="true") {
        <a asp-controller="Jewellery" asp-action="Create"><span class="nav-icon">＋</span> Add Jewellery</a>
        <a asp-controller="Account" asp-action="Logout">Logout</a>
      } else {
        <a asp-controller="Account" asp-action="Login"><span class="nav-icon">♙</span> Admin Login</a>
      }
    </nav>
  </div>
</header>

<main class="container main">@RenderBody()</main>

<footer><div class="container">© 2026 Kanishk Jewellers. All rights reserved.</div></footer>

<div id="imageLightbox" class="lightbox" aria-hidden="true">
  <button class="lightbox-close" type="button" aria-label="Close">×</button>
  <img id="lightboxImage" src="" alt="Jewellery preview"/>
</div>

<script>
(function(){
  const box=document.getElementById('imageLightbox'), img=document.getElementById('lightboxImage');
  document.querySelectorAll('.jewel-image-link').forEach(a=>a.addEventListener('click',function(e){
    e.preventDefault(); img.src=this.href; box.classList.add('show'); box.setAttribute('aria-hidden','false');
  }));
  function close(){box.classList.remove('show');box.setAttribute('aria-hidden','true');img.src='';}
  box.addEventListener('click',e=>{if(e.target===box||e.target.classList.contains('lightbox-close'))close();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape')close();});
})();
</script>
@await RenderSectionAsync("Scripts", required:false)
</body>
</html>