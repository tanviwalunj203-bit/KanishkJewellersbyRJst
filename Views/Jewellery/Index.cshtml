@model IEnumerable<Jewellery>
@{ ViewData["Title"]="Jewellery Collection"; bool admin=ViewBag.IsAdmin ?? false; var cats=(string[])ViewBag.Categories; }
<div class="page-heading"><div><p class="eyebrow">KANISHK JEWELLERS</p><h1>Jewellery Collection</h1></div>@if(admin){<a class="btn primary" asp-action="Create">+ Add Jewellery</a>}</div><form class="filters" method="get"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search jewellery name..."/><select name="category" class="form-control"><option value="">All Categories</option>@foreach(var c in cats){<option value="@c" selected="@(ViewBag.Category == c)">@c</option>}</select><button class="btn secondary" type="submit">Filter</button><a class="btn secondary" asp-action="Index">Clear</a></form>@if(!Model.Any()){<div class="empty"><div class="big">💎</div><h2>No jewellery found</h2>@if(admin){<a class="btn primary" asp-action="Create">Add Jewellery</a>}</div>}else{<div class="grid">@foreach(var item in Model){<article class="card">@if(!string.IsNullOrWhiteSpace(item.ImageFileName)){<a class="jewel-image-link" href="~/uploads/@item.ImageFileName" title="Open @item.Name"><img class="jewel-image" src="~/uploads/@item.ImageFileName" alt="@item.Name"/></a>}else{<div class="no-image">💎</div>}<div class="card-body"><span class="category">@item.Category</span><h2>@item.Name</h2><div class="details"><div><strong>Weight</strong><span>@item.Weight.ToString("0.###") g</span></div><div><strong>Carat</strong><span>@item.Carat ct</span></div></div>@if(!string.IsNullOrWhiteSpace(item.Description)){<p>@item.Description</p>}@if(admin){<div class="actions"><a class="btn secondary" asp-action="Edit" asp-route-id="@item.Id">Edit</a><a class="btn danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a></div>}</div></article>}}</div>}
