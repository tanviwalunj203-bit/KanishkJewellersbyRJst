@model Jewellery
@{ ViewData["Title"]="Delete Jewellery"; }
<div class="form-card small"><p class="eyebrow">ADMIN</p><h1>Delete Jewellery?</h1><p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>@if(!string.IsNullOrWhiteSpace(Model.ImageFileName)){<img class="preview" src="~/uploads/@Model.ImageFileName" alt="@Model.Name"/>}<div class="actions"><form asp-action="Delete" method="post"><input type="hidden" asp-for="Id"/><button class="btn danger" type="submit">Yes, Delete</button></form><a class="btn secondary" asp-action="Index">Cancel</a></div></div>
