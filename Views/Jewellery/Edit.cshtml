@model Jewellery
@{ ViewData["Title"]="Edit Jewellery"; }
<div class="form-card"><p class="eyebrow">ADMIN</p><h1>Edit Jewellery</h1><form asp-action="Edit" method="post" enctype="multipart/form-data"><input type="hidden" asp-for="Id"/><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-group"><label asp-for="Name">Jewellery Name</label><input asp-for="Name" class="form-control"/><span asp-validation-for="Name" class="validation"></span></div><div class="form-group"><label asp-for="Category">Category</label><select asp-for="Category" class="form-control"><option>Necklace</option><option>Ring</option><option>Earrings</option><option>Bracelet</option><option>Bangle</option><option>Chain</option><option>Pendant</option><option>Nose Ring</option><option>Anklet</option><option>Mangalsutra</option><option>Other</option></select></div><div class="two-col"><div class="form-group"><label asp-for="Weight">Weight (grams)</label><input asp-for="Weight" type="number" step="0.001" min="0.001" class="form-control"/></div><div class="form-group"><label asp-for="Carat">Carat</label><select asp-for="Carat" class="form-control"><option value="9">9 Carat</option><option value="18">18 Carat</option><option value="22">22 Carat</option><option value="24">24 Carat</option></select></div></div><div class="form-group"><label>Replace Image</label><input type="file" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/*"/></div><div class="form-group"><label asp-for="Description">Description</label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div><div class="actions"><button class="btn primary" type="submit">Update Jewellery</button><a class="btn secondary" asp-action="Index">Cancel</a></div></form></div>
